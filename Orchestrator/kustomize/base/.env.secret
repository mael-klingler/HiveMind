# .env.secret – Values as export KEY="value"
export GIT_HOST="gitlab.example.com"
export GIT_USER="gitlab-ci-token"
export GIT_TOKEN=""
export OLLAMA_HOST="http://localhost:11434"
export OLLAMA_MODEL="llama3:latest"
export OPENCODE_MODEL="llama3:latest"
export ORCHESTRATOR_CONFIG="/app/config/orchestrator_config.json"
export WORK_DIR="/app/workspace"
export PVC_MOUNT_PATH="/app/workspace/repos"
export TRACK_BRANCH="main"
export LEANKG_ENABLED="true"
export LOG_LEVEL="INFO"