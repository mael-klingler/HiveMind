# ── Orchestrator .env.example ──────────────────────────────────
# In K8s: Values kommen aus dem Secret "orchestrator-env".
# Lokal: Kopiere diese Datei zu .env und passe an.
# Die Haupt-.env im Projektverzeichnis ist die Single Source of Truth.
# ────────────────────────────────────────────────────────────────

# GitLab
GIT_HOST=YOUR_GITLAB_HOST
GIT_USER=gitlab-ci-token
GIT_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxxxx

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=glm-5.1:cloud
OPENCODE_MODEL=glm-5.1:cloud
OLLAMA_CLOUD_API_KEY=

# Orchestrator
ORCHESTRATOR_CONFIG=/app/config/orchestrator_config.json
WORK_DIR=/app/workspace
PVC_MOUNT_PATH=/app/workspace/repos
TRACK_BRANCH=main
LEANKG_ENABLED=true
LOG_LEVEL=INFO