{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/${OPENCODE_MODEL}",
  "small_model": "ollama/${OPENCODE_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "plugin": ${OPENCODE_PLUGINS},
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "${OLLAMA_BASE_URL}"
      },
      "models": {
        "${OPENCODE_MODEL}": {
          "name": "${OPENCODE_MODEL}",
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  }
}