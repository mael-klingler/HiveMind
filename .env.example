# ─────────────────────────────────────────────────────────────────────────────
# HiveMind – Zentrale Konfiguration (Single Source of Truth)
# ─────────────────────────────────────────────────────────────────────────────
# Diese Datei ist die SINGLE SOURCE OF TRUTH fuer alle Konfigurationswerte.
# ./setup.sh liest von hier und erstellt den K8s Secret.
# ./redeploy.sh liest von hier und aktualisiert den Secret.
# Kopiere zu .env und passe an:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── GitLab ──────────────────────────────────────────────────────────────────
GITLAB_HOST=
GIT_USER=gitlab-ci-token
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_SSH_KEY_BASE64=
SSH_KEY_PATH=

# ── Branch Defaults ────────────────────────────────────────────────────────
BRANCH_FALLBACK_ORDER=development,qa,main

# ── Ollama / LLM ────────────────────────────────────────────────────────────
# LLM_PROVIDER: ollama | ollama_cloud | openai | anthropic
# Auto-detected if empty (based on which API keys are set).
LLM_PROVIDER=
# Host OHNE /v1
OLLAMA_HOST=http://host.docker.internal:11434
# Host MIT /v1 (fuer OpenAI-compatible Provider)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b
# Timeout fuer LLM-Analyse in Sekunden
OLLAMA_TIMEOUT=120

# ── Ollama Cloud (api.ollama.com) ──────────────────────────────────────────
OLLAMA_CLOUD_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic ─────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── OpenCode (Agent) ────────────────────────────────────────────────────────
OPENCODE_MODEL=llama3.1:8b

# ── K8s / Agent ─────────────────────────────────────────────────────────────
AGENT_NAMESPACE=hivemind
AGENT_IMAGE=hivemind-opencode:latest
OPENCODE_PORT=4096
AGENT_RETRY_DELAY=120
AGENT_MAX_RETRIES=3
AGENT_WEBHOOK_SECRET=

# ── Orchestrator ────────────────────────────────────────────────────────────
ORCHESTRATOR_CONFIG=/app/config/orchestrator_config.json
ORCHESTRATOR_PORT=8080

# ── DB (SQLite – default) ──────────────────────────────────────────────────
DB_PATH=/app/data/orchestrator.db

# ── DB (PostgreSQL – alternative) ───────────────────────────────────────────
# DATABASE_URL=postgresql://hivemind:hivemind@hivemind-postgres:5432/hivemind

# ── DB (Supabase – recommended for production) ──────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS Origins (comma-separated, or * for all) ───────────────────────────
CORS_ORIGINS=*

# ── Webhook Secrets (VERIFY THESE IN PRODUCTION!) ──────────────────────────
HIVEMIND_API_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Test-Modus ──────────────────────────────────────────────────────────────
# DRY_RUN=true → opencode wird nicht ausgefuehrt, repos werden nicht gepusht
DRY_RUN=false

# ── Monitoring ──────────────────────────────────────────────────────────────
# ENABLE_MONITORING=true → installiert Prometheus + Grafana im K8s Cluster
ENABLE_MONITORING=true