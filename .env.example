# ─────────────────────────────────────────────────────────────────────────────
# HiveMind – Zentrale Konfiguration (Single Source of Truth)
# ─────────────────────────────────────────────────────────────────────────────
# Diese Datei ist die SINGLE SOURCE OF TRUTH fuer alle Konfigurationswerte.
# ./setup.sh liest von hier und erstellt den K8s Secret.
# ./redeploy.sh liest von hier und aktualisiert den Secret.
# Kopiere zu .env und passe an:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── GitLab ────────────────────────────────────────────────────────
GITLAB_HOST=gitlab.example.com
GIT_USER=gitlab-ci-token
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ── Ollama / LLM ──────────────────────────────────────────────────
# Host OHNE /v1
OLLAMA_HOST=http://host.docker.internal:11434
# Host MIT /v1 (fuer OpenAI-compatible Provider)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=glm-5.1:cloud

# ── OpenCode (Agent) ──────────────────────────────────────────────
OPENCODE_MODEL=glm-5.1:cloud

# Ollama Cloud API Key (optional, fuer Cloud-Modelle)
OLLAMA_CLOUD_API_KEY=

# ── K8s / Agent ────────────────────────────────────────────────────
AGENT_NAMESPACE=hivemind
AGENT_IMAGE=hivemind-opencode:latest

# ── Orchestrator ──────────────────────────────────────────────────
ORCHESTRATOR_CONFIG=/app/config/orchestrator_config.json
OPENCODE_PORT=4096

# ── Test-Modus ──────────────────────────────────────────────────────
# DRY_RUN=true → opencode wird nicht ausgefuehrt, repos werden nicht gepusht
DRY_RUN=false