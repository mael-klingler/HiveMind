# HiveMind – Zentrale Konfiguration (Single Source of Truth)
# ============================================================
# Kopiere zu .env und passe an:  cp .env.example .env
# ./setup.sh liest von hier und erstellt den K8s Secret.
# ./redeploy.sh liest von hier und aktualisiert den Secret.
# ============================================================

# GitLab
GITLAB_HOST=gitlab.capturecore.org
GIT_USER=agent1
GITLAB_TOKEN=glpat-xxxx
GITLAB_SSH_KEY_BASE64=
SSH_KEY_PATH=

# Branch Defaults
BRANCH_FALLBACK_ORDER=development,qa,main

# Ollama / LLM
OLLAMA_HOST=http://ollama.kagent.svc.cluster.local:11434
OLLAMA_BASE_URL=http://ollama.kagent.svc.cluster.local:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=300

# OpenCode (Agent)
OPENCODE_MODEL=llama3.2

# Ollama Cloud API Key (optional)
OLLAMA_CLOUD_API_KEY=

# K8s / Agent
AGENT_NAMESPACE=hivemind
AGENT_IMAGE=reg.capturecore.org/capturecore/hivemind-opencode:latest
OPENCODE_PORT=4096
AGENT_RETRY_DELAY=30
AGENT_MAX_RETRIES=3
AGENT_STALE_TIMEOUT=3600
AGENT_WEBHOOK_SECRET=

# Orchestrator
ORCHESTRATOR_CONFIG=/app/config/orchestrator_config.json
ORCHESTRATOR_PORT=8080

# DB (SQLite – default)
DB_PATH=/app/data/orchestrator.db

# DB (PostgreSQL – alternative)
# DATABASE_URL=postgresql://hivemind:hivemind@hivemind-postgres:5432/hivemind

# CORS
CORS_ORIGINS=https://hivemind.capturecore.org

# Auth
HIVEMIND_API_KEY=
GITHUB_WEBHOOK_SECRET=

# Test mode
DRY_RUN=false

# Monitoring
ENABLE_MONITORING=true

# SSL (self-signed CA for cluster-internal HTTPS)
SSL_VERIFY=false