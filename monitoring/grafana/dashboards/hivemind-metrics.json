    {
      "title": "Tickets by Status",
      "type": "barchart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": {} },
      "targets": [{ "expr": "hivemind_tickets", "legendFormat": "{{status}}", "refId": "A" }],
      "options": { "orientation": "horizontal", "groupWidth": 0.7 }
    },
    {
      "title": "Ticket Lifecycle Events (rate)",
