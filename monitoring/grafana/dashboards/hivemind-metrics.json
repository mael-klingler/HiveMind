  "panels": [
    {
      "title": "Agent Success Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 50, "color": "orange" },
              { "value": 80, "color": "green" }
            ]
          }
        }
      },
      "targets": [{ "expr": "hivemind_agent_success_rate", "legendFormat": "Success Rate", "refId": "A" }]
    },
    {
      "title": "Test First-Pass Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 40, "color": "orange" },
              { "value": 70, "color": "green" }
            ]
          }
        }
      },
      "targets": [{ "expr": "hivemind_test_first_pass_rate", "legendFormat": "First-Pass Rate", "refId": "A" }]
    },
    {
      "title": "Avg Review Cycles",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 3, "color": "orange" },
              { "value": 5, "color": "red" }
            ]
          }
        }
      },
      "targets": [{ "expr": "hivemind_avg_review_cycles", "legendFormat": "Avg Cycles", "refId": "A" }]
    },
    {
      "title": "Avg Retry Count",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 2, "color": "orange" },
              { "value": 3, "color": "red" }
            ]
          }
        }
      },
      "targets": [{ "expr": "hivemind_avg_retry_count", "legendFormat": "Avg Retries", "refId": "A" }]
